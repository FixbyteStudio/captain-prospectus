{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-pwa/client", "vite-plugin-pwa/react", "vitest/globals"],
    "paths": {
      "@/*": ["./src/client/*"]
    }
  },
  // test/setup-dom.ts and test/stubs are DOM code, so they typecheck here
  // rather than under tsconfig.worker.json, which owns the rest of test/.
  "include": ["src/client", "src/shared", "test/setup-dom.ts", "test/stubs"]
}
