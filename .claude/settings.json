{
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm test:*)",
      "Bash(npm run db:generate)",
      "Bash(npm run db:migrate:local)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(npx wrangler deploy:*)",
      "Bash(wrangler deploy:*)",
      "Bash(npm run deploy:*)",
      "Bash(npm run db:migrate:remote:*)",
      "Bash(npx wrangler secret:*)",
      "Bash(npx wrangler d1 execute:*)",
      "Read(./.dev.vars)"
    ]
  }
}
